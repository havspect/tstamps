{
  "name": "tstamps-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen": "go run ../cmd/tstamps-server openapi > openapi.json && openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
    "check": "pnpm gen && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "chart.js": "^4.6.1",
    "openapi-fetch": "^0.17.0"
  }
}
