[Unit]
Description=Tstamps time tracking server
Documentation=https://github.com/havspect/tstamps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tstamps
Group=tstamps
StateDirectory=tstamps
StateDirectoryMode=0750
# Every workspace lives in this one database.
ExecStart=/usr/local/bin/tstamps-server serve --addr 127.0.0.1:8080 --db /var/lib/tstamps/tstamps.db
Restart=on-failure
RestartSec=2
UMask=0077
# The database lives in StateDirectory; nothing else on the host is writable.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
