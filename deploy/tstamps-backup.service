[Unit]
Description=Back up the Tstamps database
Documentation=https://github.com/havspect/tstamps
After=tstamps-server.service
Wants=tstamps-server.service

[Service]
Type=oneshot
User=tstamps
Group=tstamps
# SQLite opens the database read-write even for a snapshot: WAL needs the -shm
# file and the directory writable, so grant the same StateDirectory as serve.
StateDirectory=tstamps
StateDirectoryMode=0750
# Created by hand in the install steps; the backup command refuses to overwrite.
ReadWritePaths=/var/backups/tstamps
# One workspace. For hosted mode, replace --db ... with:
# --workspace-dir /var/lib/tstamps/workspaces /var/backups/tstamps/tstamps-$(date ...)
# and change the cleanup to remove old snapshot directories.
ExecStart=/bin/sh -c 'exec /usr/local/bin/tstamps-server backup --db /var/lib/tstamps/tstamps.db /var/backups/tstamps/tstamps-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).db'
ExecStartPost=/bin/sh -c 'find /var/backups/tstamps -name "tstamps-*.db" -type f -mtime +14 -delete'
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
