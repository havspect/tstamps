# Terminates TLS and forwards to the server on localhost. Caddy sets
# X-Forwarded-Proto, which is how the server knows to use the __Host- cookie;
# the binary must never be reachable except through this proxy.
#
# Replace the hostname, point its DNS at this VM, then: caddy reload
tstamps.example.com {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy 127.0.0.1:8080
}

# The public demo is a second instance with its own database. Its accounts are
# public, so keep it out of search results. Replace the hostname, then reload.
demo.tstamps.example.com {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Robots-Tag "noindex"
	reverse_proxy 127.0.0.1:8081
}
